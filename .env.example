# ==============================================================================
# JABALPUR RENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with real sandbox credentials.
# NEVER commit the real .env file or production keys to version control.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5500

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (PostgreSQL + Auth + Storage)
# ------------------------------------------------------------------------------
# Obtain from: https://app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Browser-safe client key (Respects Row-Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Backend-only privileged key (Bypasses RLS - NEVER expose to browser!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
# Direct PostgreSQL connection string (for migrations and CLI)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase Storage Buckets
STORAGE_BUCKET_LISTING_IMAGES=listing-images
STORAGE_BUCKET_VERIFICATION_DOCS=verification-documents-private
STORAGE_BUCKET_SHOP_DOCS=shop-documents-private

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (SANDBOX / TEST MODE)
# ------------------------------------------------------------------------------
# Provider: Razorpay (Test mode key id starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Alternative Provider: Cashfree Payments (Sandbox)
CASHFREE_APP_ID=TEST_your_cashfree_app_id
CASHFREE_SECRET_KEY=TEST_your_cashfree_secret_key
CASHFREE_ENV=TEST
CASHFREE_WEBHOOK_SECRET=YourCashfreeWebhookSecretHere

# ------------------------------------------------------------------------------
# IDENTITY & KYC VERIFICATION (SANDBOX / MOCK MODE)
# ------------------------------------------------------------------------------
# Provider options: Setu DigiLocker API / Cashfree Verification Suite
KYC_PROVIDER=sandbox_mock
KYC_API_KEY=mock_kyc_api_key_for_testing
KYC_API_SECRET=mock_kyc_api_secret_for_testing
KYC_WEBHOOK_SECRET=mock_kyc_webhook_secret

# ------------------------------------------------------------------------------
# NOTIFICATIONS (SMS / WHATSAPP)
# ------------------------------------------------------------------------------
# Provider: Fast2SMS / Meta WhatsApp Cloud API
SMS_PROVIDER=sandbox_mock
SMS_API_KEY=mock_sms_api_key
WHATSAPP_TOKEN=mock_whatsapp_cloud_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id

# ------------------------------------------------------------------------------
# SECURITY & SESSION SECRETS
# ------------------------------------------------------------------------------
# Random 64-character hex string for signing internal session/CSRF tokens
INTERNAL_TOKEN_SECRET=replace_with_64_char_random_hex_string_generate_with_openssl
ADMIN_REGISTRATION_KEY=replace_with_high_entropy_secret_for_initial_admin_setup
